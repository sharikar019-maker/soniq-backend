import Order     from "../models/Order.js";
import mongoose  from "mongoose";
import AppError  from "../utils/AppError.js";

const VALID_STATUSES     = ["Pending", "Processing", "Shipped", "Delivered", "Cancelled"];


const STATUS_TRANSITIONS = {
  Pending:    ["Processing", "Cancelled"],
  Processing: ["Shipped",    "Cancelled"],
  Shipped:    ["Delivered"],
  Delivered:  [],   
  Cancelled:  [],   
};



export const getAllOrders = async (req, res, next) => {
  try {
    const page  = Math.max(parseInt(req.query.page)  || 1, 1);
    const limit = Math.min(parseInt(req.query.limit) || 20, 100);
    const skip  = (page - 1) * limit;

    const matchStage = {};
    if (req.query.status && VALID_STATUSES.includes(req.query.status)) {
      matchStage.status = req.query.status;
    }

    const [result] = await Order.aggregate([
      { $match: matchStage },

      
      {
        $lookup: {
          from:        "users",
          localField:  "user",
          foreignField: "_id",
          as:          "user",
          pipeline:    [{ $project: { name: 1, email: 1 } }],
        },
      },
      { $unwind: { path: "$user", preserveNullAndEmpty: true } },

      
      {
        $facet: {
          metadata: [{ $count: "total" }],
          orders: [
            { $sort: { createdAt: -1 } },
            { $skip: skip },
            { $limit: limit },
            {
              $project: {
                status:        1,
                totalAmount:   1,
                paymentMethod: 1,
                paymentStatus: 1,
                createdAt:     1,
                itemCount:     { $size: "$items" },
                "user.name":   1,
                "user.email":  1,
              },
            },
          ],
        },
      },
    ]);

    const total = result.metadata[0]?.total || 0;

    res.status(200).json({
      success:     true,
      total,
      currentPage: page,
      totalPages:  Math.ceil(total / limit),
      data:        result.orders,
    });
  } catch (err) {
    next(err);
  }
};



export const getOrderStats = async (req, res, next) => {
  try {
    const year  = parseInt(req.query.year) || new Date().getFullYear();
    const start = new Date(year, 0,  1);
    const end   = new Date(year, 11, 31, 23, 59, 59);

    const [result] = await Order.aggregate([
      {
        $facet: {

          
          monthlyRevenue: [
            {
              $match: {
                createdAt: { $gte: start, $lte: end },
                status:    { $nin: ["Cancelled"] },
              },
            },
            {
              $group: {
                _id:     { $month: "$createdAt" },
                revenue: { $sum: "$totalAmount" },
                orders:  { $sum: 1 },
              },
            },
            { $sort: { _id: 1 } },
            { $project: { _id: 0, month: "$_id", revenue: 1, orders: 1 } },
          ],

          
          statusCounts: [
            {
              $group: {
                _id:   "$status",
                count: { $sum: 1 },
              },
            },
            { $project: { _id: 0, status: "$_id", count: 1 } },
          ],

          
          totals: [
            {
              $group: {
                _id:          null,
                totalRevenue: { $sum: "$totalAmount" },
                totalOrders:  { $sum: 1 },
              },
            },
            { $project: { _id: 0 } },
          ],
        },
      },
    ]);

  
    const monthMap = Object.fromEntries(result.monthlyRevenue.map((m) => [m.month, m]));
    const fullYear = Array.from({ length: 12 }, (_, i) => ({
      month:   i + 1,
      revenue: monthMap[i + 1]?.revenue || 0,
      orders:  monthMap[i + 1]?.orders  || 0,
    }));

    res.status(200).json({
      success: true,
      data: {
        monthlyRevenue: fullYear,
        statusCounts:   result.statusCounts,
        totals:         result.totals[0] || { totalRevenue: 0, totalOrders: 0 },
      },
    });
  } catch (err) {
    next(err);
  }
};



export const updateOrderStatus = async (req, res, next) => {
  try {
    const { id }     = req.params;
    const { status } = req.body;

    if (!mongoose.Types.ObjectId.isValid(id))
      return next(new AppError("Invalid order ID", 400));

    if (!status || !VALID_STATUSES.includes(status))
      return next(new AppError(`Status must be one of: ${VALID_STATUSES.join(", ")}`, 400));

    
    const order = await Order.findById(id).select("status").lean();
    if (!order) return next(new AppError("Order not found", 404));

    const allowed = STATUS_TRANSITIONS[order.status];
    if (!allowed.includes(status)) {
      return next(
        new AppError(
          `Cannot change status from "${order.status}" to "${status}". ` +
            (allowed.length
              ? `Allowed next: ${allowed.join(", ")}`
              : `"${order.status}" is a terminal status.`),
          400
        )
      );
    }

   
    const updated = await Order.findByIdAndUpdate(
      id,
      {
        $set:  { status },
        $push: { statusHistory: { status, changedAt: new Date() } },
      },
      { new: true, select: "status statusHistory" }
    ).lean();

    res.status(200).json({ success: true, data: updated });
  } catch (err) {
    next(err);
  }
};